# ====================================================================
# NEET PG Master - Production Environment Configuration
# ====================================================================

# Database (SQLite local path or PostgreSQL URL)
DATABASE_URL=sqlite:///data/neet_pg.db

# Security (REQUIRED: Generate a strong 64-char random secret for production)
SECRET_KEY=replace-with-a-cryptographically-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
DEBUG=False

# Frontend Origin & Trusted CORS Origins
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cookie Security (Automatically enabled when FRONTEND_URL starts with https://)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Transactional Email Service (Resend)
RESEND_API_KEY=
EMAIL_FROM="NEET PG Master <noreply@yourdomain.com>"
EMAIL_VERIFICATION_EXPIRE_HOURS=24
PASSWORD_RESET_EXPIRE_MINUTES=30

# Optional Administrator Registration Notification
ADMIN_NOTIFICATION_EMAIL=

# Optional Google Sign-In OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=

# Optional Legacy SMTP Fallback (Used only if RESEND_API_KEY is unset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME="NEET PG Master"
OTP_EXPIRE_MINUTES=10
